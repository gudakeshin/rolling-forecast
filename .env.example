# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE
ANTHROPIC_MODEL=claude-sonnet-5

# JWT Secret (REQUIRED: >=32 chars in production)
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string

# Database (SQLite for local dev; Postgres for production compose)
DATABASE_URL=sqlite:///./rolling_forecast.db
# DATABASE_URL=postgresql://forecast:forecast@db:5432/rolling_forecast

# Application
APP_ENV=development
LOG_LEVEL=INFO
ALLOW_OPEN_REGISTRATION=true
SEED_DEMO_USERS=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OIDC / SSO (optional)
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback

# Observability (optional)
OTEL_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Integrations
WAREHOUSE_CONNECTION_URL=
ERP_API_URL=
ERP_API_TOKEN=

# Distribution (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DISTRIBUTION_FROM_EMAIL=forecasts@example.com

# Context Engine - External Search APIs
PERPLEXITY_API_KEY=
FRED_API_KEY=
FINANCIAL_DATASETS_API_KEY=
